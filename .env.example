# Nino Frontend 8.0.0+
# Copier ce fichier vers `.env` ou `.env.local`.

# Serveur frontend (utilisé par `npm run dev` et `npm start`)
PORT=8006
HOSTNAME=0.0.0.0

# Backend Nino 8.0.0+, sans slash final.
# Cette valeur est intégrée au bundle navigateur pendant `npm run build`.
NEXT_PUBLIC_NINO_API_URL=http://127.0.0.1:8005

# Le backend doit autoriser les deux origines suivantes dans sa configuration CORS :
# http://localhost:8006 et http://127.0.0.1:8006

# Désactive la télémétrie Next.js (optionnel)
NEXT_TELEMETRY_DISABLED=1
