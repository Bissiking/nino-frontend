# Nino Frontend 8.0.0+
# Copier ce fichier vers `.env` ou `.env.local`.

# Serveur frontend (utilisé par `npm run dev` et `npm start`)
PORT=8006
HOSTNAME=0.0.0.0

# Backend Nino 8.0.0+, sans slash final.
# Cette valeur est intégrée au bundle navigateur pendant `npm run build`.
NEXT_PUBLIC_NINO_API_URL=http://localhost:8004

# Le backend doit autoriser les origines locales utilisées dans le navigateur :
# http://localhost:8006, http://127.0.0.1:8006 et http://0.0.0.0:8006
# Pour le SSO, utilisez le même nom d'hôte (`localhost` ou `127.0.0.1`) pour
# le frontend, le callback Kyros et l'URL publique du backend.

# Désactive la télémétrie Next.js (optionnel)
NEXT_TELEMETRY_DISABLED=1
